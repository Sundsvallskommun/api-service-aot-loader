{
	"name": "support-management-create-investigation",
	"request": {
		"method": "POST",
		"url": "/support-management/2281/AOT/errands/11111111-aaaa-bbbb-cccc-000000000011/investigations",
		"headers": {
			"X-Sent-By": {
				"hasExactly": [
					{
						"equalTo": "alkt-migration; type=migration"
					}
				]
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": {
					"expression": "$.status",
					"equalTo": "COMPLETED"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.conclusion",
					"equalTo": "<p><strong>Tillsynsomgång</strong></p><p>Kontrollköp vecka 18, 2024-05-03</p><p><strong>Anteckning</strong></p><p>Köpet nekades.</p><p><strong>Anmärkningar</strong></p><p>Påträngande reklam i butik</p>"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.type",
					"absent": true
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.parameters",
					"absent": true
				}
			}
		]
	},
	"response": {
		"status": 201,
		"headers": {
			"Location": "/2281/AOT/errands/11111111-aaaa-bbbb-cccc-000000000011/investigations/investigation-1"
		}
	}
}
