{
	"name": "support-management-create-investigation",
	"request": {
		"method": "POST",
		"url": "/support-management/2281/AOT/errands/11111111-aaaa-bbbb-cccc-000000000011/investigations",
		"headers": {
			"X-Sent-By": {
				"hasExactly": [
					{
						"equalTo": "alkt-migration; type=migration"
					}
				]
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": {
					"expression": "$.status",
					"equalTo": "COMPLETED"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.description",
					"equalTo": "Tillsynsomgång: Kontrollköp vecka 18, 2024-05-03"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.summary",
					"equalTo": "Köpet nekades."
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.conclusion",
					"equalTo": "Påträngande reklam i butik"
				}
			}
		]
	},
	"response": {
		"status": 201,
		"headers": {
			"Location": "/2281/AOT/errands/11111111-aaaa-bbbb-cccc-000000000011/investigations/investigation-1"
		}
	}
}
