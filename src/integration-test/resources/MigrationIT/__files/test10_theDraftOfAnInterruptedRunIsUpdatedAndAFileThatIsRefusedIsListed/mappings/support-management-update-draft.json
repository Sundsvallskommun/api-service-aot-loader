{
	"name": "support-management-update-draft",
	"request": {
		"method": "PATCH",
		"url": "/support-management/2281/AOT/errands/11111111-aaaa-bbbb-cccc-000000000003",
		"headers": {
			"X-Sent-By": {
				"hasExactly": [
					{
						"equalTo": "alkt-migration; type=migration"
					}
				]
			},
			"X-Trigger-Process": {
				"hasExactly": [
					{
						"equalTo": "false"
					}
				]
			},
			"X-notify": {
				"hasExactly": [
					{
						"equalTo": "false"
					}
				]
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": "$.title"
			},
			{
				"doesNotMatch": "(?s).*handelselogg.*"
			},
			{
				"matchesJsonPath": "$.parameters[?(@.key == 'handlaggare' && @.values.length() == 1 && @.values[0] == 'Karin Andersson')]"
			},
			{
				"doesNotMatch": "(?s).*\"(reporterUserId|lifecycle)\".*"
			}
		]
	},
	"response": {
		"status": 200,
		"headers": {
			"Content-Type": "application/json"
		},
		"jsonBody": {
			"id": "11111111-aaaa-bbbb-cccc-000000000003",
			"errandNumber": "ALKT-2026-3",
			"lifecycle": "DRAFT"
		}
	}
}
