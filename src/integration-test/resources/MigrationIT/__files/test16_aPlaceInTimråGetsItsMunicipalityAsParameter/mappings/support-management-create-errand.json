{
	"name": "support-management-create-errand",
	"request": {
		"method": "POST",
		"url": "/support-management/2281/AOT/errands",
		"headers": {
			"X-Sent-By": {
				"hasExactly": [
					{
						"equalTo": "alkt-migration; type=migration"
					}
				]
			},
			"X-Trigger-Process": {
				"hasExactly": [
					{
						"equalTo": "false"
					}
				]
			},
			"X-notify": {
				"hasExactly": [
					{
						"equalTo": "false"
					}
				]
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": {
					"expression": "$.status",
					"equalTo": "CLOSED"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.classification.category",
					"equalTo": "ALCOHOL"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.classification.type",
					"equalTo": "FOLKOL_SALES_NOTIFICATION"
				}
			},
			{
				"matchesJsonPath": "$.externalTags[?(@.key == 'migreringsid' && @.value == 'ALKOL-ANMALAN-2-FOLKOL')]"
			},
			{
				"matchesJsonPath": "$.labels[?(@.id == 'label-migrated')]"
			},
			{
				"matchesJsonPath": {
					"expression": "$.parameters[?(@.key == 'premisesName')].values[0]",
					"equalTo": "Timråkiosken"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.parameters[?(@.key == 'omrade')].values[0]",
					"equalTo": "Timrå"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.parameters[?(@.key == 'premisesMunicipalityId')].values[0]",
					"equalTo": "2262"
				}
			}
		]
	},
	"response": {
		"status": 201,
		"headers": {
			"Location": "/2281/AOT/errands/11111111-aaaa-bbbb-cccc-000000000004"
		}
	}
}
