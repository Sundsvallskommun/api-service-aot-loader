{
	"name": "support-management-create-errand",
	"request": {
		"method": "POST",
		"url": "/support-management/2281/AOT/errands",
		"headers": {
			"X-Sent-By": {
				"hasExactly": [
					{
						"equalTo": "alkt-migration; type=migration"
					}
				]
			},
			"X-Trigger-Process": {
				"hasExactly": [
					{
						"equalTo": "false"
					}
				]
			},
			"X-notify": {
				"hasExactly": [
					{
						"equalTo": "false"
					}
				]
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": {
					"expression": "$.lifecycle",
					"equalTo": "DRAFT"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.status",
					"equalTo": "CLOSED"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.title",
					"equalTo": "Tillsynsbesök – Krogen Ett"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.classification.category",
					"equalTo": "INSPECTION"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.classification.type",
					"equalTo": "EXTERNAL_INSPECTION"
				}
			},
			{
				"matchesJsonPath": "$.externalTags[?(@.key == 'migreringsid' && @.value == 'ALKT-TILLSYNSBESOK-900')]"
			},
			{
				"matchesJsonPath": "$.labels[?(@.id == 'label-migrated')]"
			},
			{
				"matchesJsonPath": "$.labels[?(@.id == 'label-external-inspection')]"
			},
			{
				"matchesJsonPath": "$.labels[?(@.id == 'label-alcohol-inspection')]"
			},
			{
				"matchesJsonPath": "$[?(@.description =~ /.*<p>Tillsynsart: Rutintillsyn<\\/p>.*/)]"
			},
			{
				"matchesJsonPath": "$[?(@.description =~ /.*<p>Tid: 21:30–23:00<\\/p>.*/)]"
			},
			{
				"matchesJsonPath": "$[?(@.description =~ /.*<p>- Servering till minderårig: Ungdomar i baren<\\/p>.*/)]"
			},
			{
				"matchesJsonPath": "$[?(@.description =~ /.*<p>- Servering utom tillåten serveringstid<\\/p>.*/)]"
			},
			{
				"matchesJsonPath": "$[?(@.description =~ /.*<p>Kontrollant: Anna Berg, XYZ<\\/p>.*/)]"
			},
			{
				"matchesJsonPath": "$[?(@.description =~ /.*<p>Serveringspersonal: Ägaren på plats, Personal registrerad vid besöket<\\/p>.*/)]"
			},
			{
				"matchesJsonPath": "$.parameters[?(@.key == 'restaurantNumber' && @.values[0] == '12345678')]"
			},
			{
				"matchesJsonPath": "$[?(@.description =~ /.*<p>Tillsynsomgång: Krogrunda, 2023-11-04 – 2023-11-05<\\/p>.*/)]"
			},
			{
				"matchesJsonPath": "$[?(@.measures.length() == 2)]"
			},
			{
				"matchesJsonPath": "$.measures[?(@.type == 'EXTERNAL' && @.title == 'Servering till minderårig' && @.description == 'Ungdomar i baren' && @.status == 'COMPLETED' && @.addedByUser == 'alkt-migration' && @.addedByRole == 'PRIMARY')]"
			},
			{
				"matchesJsonPath": "$.measures[?(@.type == 'EXTERNAL' && @.title == 'Servering utom tillåten serveringstid' && @.status == 'COMPLETED')]"
			},
			{
				"matchesJsonPath": {
					"expression": "$.description",
					"contains": "<p>Tillsynsart: Rutintillsyn</p><p>Tid: 21:30–23:00</p><p>Tillsynsomgång: Krogrunda, 2023-11-04 – 2023-11-05</p>"
				}
			},
			{
				"matches": "(?s).*Anteckning: Mycket folk i baren[.].*"
			},
			{
				"doesNotMatch": "(?s).*\"role\".*"
			}
		]
	},
	"response": {
		"status": 201,
		"headers": {
			"Location": "/2281/AOT/errands/11111111-aaaa-bbbb-cccc-000000000010"
		}
	}
}
