{
	"name": "support-management-create-decision",
	"request": {
		"method": "POST",
		"url": "/support-management/2281/AOT/errands/11111111-aaaa-bbbb-cccc-000000000005/decisions",
		"headers": {
			"X-Sent-By": {
				"hasExactly": [
					{
						"equalTo": "mig01dec; type=adAccount"
					}
				]
			},
			"X-Trigger-Process": {
				"hasExactly": [
					{
						"equalTo": "false"
					}
				]
			},
			"X-notify": {
				"hasExactly": [
					{
						"equalTo": "false"
					}
				]
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": {
					"expression": "$.status",
					"equalTo": "DRAFT"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.type",
					"equalTo": "SERVERINGSTILLSTAND"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.title",
					"equalTo": "Beslut om serveringstillstånd för alkoholdrycker"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.description",
					"equalTo": "Beslutet finns inte i AlkT och bygger på tillståndet"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.outcome",
					"equalTo": "APPROVAL"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.method",
					"equalTo": "MANUAL"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.decidedBy",
					"equalTo": "Uppgift saknas i AlkT"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.decidedAt",
					"matches": "2020-01-01T00:00(:00)?\\+01:00"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.validFrom",
					"equalTo": "2020-01-01"
				}
			},
			{
				"matchesJsonPath": "$.parameters[?(@.key == 'decisionText' && @.values[0] == 'Bifall')]"
			},
			{
				"matchesJsonPath": "$.parameters[?(@.key == 'premisesName' && @.values[0] == 'Krogen Två')]"
			}
		]
	},
	"response": {
		"status": 201,
		"headers": {
			"Location": "/2281/AOT/errands/11111111-aaaa-bbbb-cccc-000000000005/decisions/decision-1"
		}
	}
}
