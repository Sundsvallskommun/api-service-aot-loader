{
	"name": "support-management-create-investigation",
	"request": {
		"method": "POST",
		"url": "/support-management/2281/AOT/errands/11111111-aaaa-bbbb-cccc-000000000001/investigations",
		"headers": {
			"X-Sent-By": {
				"hasExactly": [
					{
						"equalTo": "alkt-migration; type=migration"
					}
				]
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": {
					"expression": "$.status",
					"equalTo": "COMPLETED"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.conclusion",
					"contains": "<p><strong>Noteringar</strong></p><p>Ansökan komplett</p>"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.conclusion",
					"contains": "<p><strong>Beslut</strong></p><p>2019-04-30 Serveringstillstånd, beslutsfattare Anna Berg: Tillstånd beviljas.</p><p>Med villkor om bordsservering.</p>"
				}
			}
		]
	},
	"response": {
		"status": 201,
		"headers": {
			"Location": "/2281/AOT/errands/11111111-aaaa-bbbb-cccc-000000000001/investigations/investigation-1"
		}
	}
}
