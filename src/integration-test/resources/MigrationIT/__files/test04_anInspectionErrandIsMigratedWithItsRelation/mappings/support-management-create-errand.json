{
	"name": "support-management-create-errand",
	"request": {
		"method": "POST",
		"url": "/support-management/2281/AOT/errands",
		"headers": {
			"X-Sent-By": {
				"hasExactly": [
					{
						"equalTo": "alkt-migration; type=migration"
					}
				]
			},
			"X-Trigger-Process": {
				"hasExactly": [
					{
						"equalTo": "false"
					}
				]
			},
			"X-notify": {
				"hasExactly": [
					{
						"equalTo": "false"
					}
				]
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": {
					"expression": "$.status",
					"equalTo": "CLOSED"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.classification.category",
					"equalTo": "INSPECTION"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.classification.type",
					"equalTo": "INTERNAL_INSPECTION"
				}
			},
			{
				"matchesJsonPath": "$.externalTags[?(@.key == 'migreringsid' && @.value == 'ALKT-TILLSYN-700')]"
			},
			{
				"matchesJsonPath": "$.labels[?(@.id == 'label-migrated')]"
			},
			{
				"matchesJsonPath": "$.labels[?(@.id == 'label-alcohol-inspection')]"
			},
			{
				"matchesJsonPath": "$.labels[?(@.id == 'label-internal-inspection')]"
			},
			{
				"matchesJsonPath": "$.jsonParameters[?(@.key == 'aot_inspection_internal_inspection' && @.schemaId == '2281_aot_inspection_internal_inspection_1.2' && @.value.premises.name == 'Krogen Ett' && @.value.premises.restaurantNumber == '12345678' && @.value.premises.municipalityId == '2281')]"
			},
			{
				"matchesJsonPath": {
					"expression": "$.jsonParameters.length()",
					"equalTo": "1"
				}
			},
			{
				"matchesJsonPath": "$[?(@.description =~ /.*<p>Handläggare: Anna Berg, XYZ<\\/p>.*/)]"
			},
			{
				"matchesJsonPath": "$.stakeholders[?(@.role == 'CONTACT' && @.externalId == '22222222-aaaa-bbbb-cccc-000000000001')]"
			},
			{
				"doesNotMatch": "(?s).*referredFrom.*"
			}
		]
	},
	"response": {
		"status": 201,
		"headers": {
			"Location": "/2281/AOT/errands/11111111-aaaa-bbbb-cccc-000000000002"
		}
	}
}
