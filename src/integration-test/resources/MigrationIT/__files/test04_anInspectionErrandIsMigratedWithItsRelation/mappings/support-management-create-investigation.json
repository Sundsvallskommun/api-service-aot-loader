{
	"name": "support-management-create-investigation",
	"request": {
		"method": "POST",
		"url": "/support-management/2281/AOT/errands/11111111-aaaa-bbbb-cccc-000000000002/investigations",
		"headers": {
			"X-Sent-By": {
				"hasExactly": [
					{
						"equalTo": "alkt-migration; type=migration"
					}
				]
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": {
					"expression": "$.status",
					"equalTo": "COMPLETED"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.description",
					"equalTo": "Klagomål från grannar"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.summary",
					"equalTo": "2021-01-15 Anteckning (sekretess): Samtal med bolaget\n2021-01-18 Remiss till polisen (diarienummer TIL-2020-3)\n2021-01-20 Bild: Fasaden mot torget"
				}
			}
		]
	},
	"response": {
		"status": 201,
		"headers": {
			"Location": "/2281/AOT/errands/11111111-aaaa-bbbb-cccc-000000000002/investigations/investigation-1"
		}
	}
}
