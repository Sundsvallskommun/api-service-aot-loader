{
	"name": "support-management-create-decision",
	"request": {
		"method": "POST",
		"url": "/support-management/2281/AOT/errands/11111111-aaaa-bbbb-cccc-000000000009/decisions",
		"headers": {
			"X-Sent-By": {
				"hasExactly": [
					{
						"equalTo": "mig01dec; type=adAccount"
					}
				]
			},
			"X-Trigger-Process": {
				"hasExactly": [
					{
						"equalTo": "false"
					}
				]
			},
			"X-notify": {
				"hasExactly": [
					{
						"equalTo": "false"
					}
				]
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": {
					"expression": "$.status",
					"equalTo": "DRAFT"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.type",
					"equalTo": "PERMIT"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.method",
					"equalTo": "MANUAL"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.title",
					"equalTo": "Anmälan om försäljning av folköl"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.description",
					"equalTo": "Anmälan om försäljning av folköl – Kiosken"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.outcome",
					"equalTo": "APPROVAL"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.decidedBy",
					"equalTo": "Uppgift saknas i AlkOL"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.decidedAt",
					"matches": "2015-03-01T00:00(:00)?\\+01:00"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.validFrom",
					"equalTo": "2015-03-01"
				}
			},
			{
				"matchesJsonPath": {
					"expression": "$.investigationId",
					"absent": true
				}
			}
		]
	},
	"response": {
		"status": 201,
		"headers": {
			"Location": "/2281/AOT/errands/11111111-aaaa-bbbb-cccc-000000000009/decisions/decision-1"
		}
	}
}
