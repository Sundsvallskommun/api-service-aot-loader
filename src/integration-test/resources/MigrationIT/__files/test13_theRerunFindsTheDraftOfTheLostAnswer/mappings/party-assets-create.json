{
	"name": "party-assets-create",
	"request": {
		"method": "POST",
		"urlPath": "/party-assets/2281/assets",
		"headers": {
			"X-Sent-By": {
				"hasExactly": [
					{
						"equalTo": "alkt-migration; type=migration"
					}
				]
			}
		},
		"queryParameters": {
			"sourceReference": {
				"equalTo": "LINK|11111111-aaaa-bbbb-cccc-000000000009;case;supportmanagement;AOT|"
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": {
					"expression": "$.type",
					"equalTo": "LowAlcoholBeerSalesNotification"
				}
			}
		]
	},
	"response": {
		"status": 201,
		"headers": {
			"Location": "/2281/assets/asset-internal-9"
		}
	}
}
