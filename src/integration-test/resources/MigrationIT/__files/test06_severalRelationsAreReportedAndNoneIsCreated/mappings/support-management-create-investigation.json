{
	"name": "support-management-create-investigation",
	"request": {
		"method": "POST",
		"url": "/support-management/2281/AOT/errands/11111111-aaaa-bbbb-cccc-000000000008/investigations",
		"headers": {
			"X-Sent-By": {
				"hasExactly": [
					{
						"equalTo": "alkt-migration; type=migration"
					}
				]
			}
		},
		"bodyPatterns": [
			{
				"matchesJsonPath": {
					"expression": "$.status",
					"equalTo": "COMPLETED"
				}
			}
		]
	},
	"response": {
		"status": 201,
		"headers": {
			"Location": "/2281/AOT/errands/11111111-aaaa-bbbb-cccc-000000000008/investigations/investigation-1"
		}
	}
}
