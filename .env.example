# Copy this file to .env, which git ignores, and fill it in. Write values without quotes, one per line.
#
# Never put a key or a password in the file. AOT_LOADER_CLIENT_SECRET is typed in when the service is started (see the
# README), and the source databases are read with your Windows account, so they have no password here.

# The API gateway: the client and its token endpoint
AOT_LOADER_CLIENT_ID=
AOT_LOADER_TOKEN_URI=https://<api-gateway>/token

# The target systems, through the API gateway
SUPPORT_MANAGEMENT_URL=https://<api-gateway>/<supportmanagement>/<version>
PARTY_ASSETS_URL=https://<api-gateway>/<partyassets>/<version>
PARTY_URL=https://<api-gateway>/<party>/<version>
RELATION_URL=https://<api-gateway>/<relations>/<version>

# The source databases, read only
ALKT_DB_URL=jdbc:sqlserver://<server>:1433;databaseName=<AlkT database>;integratedSecurity=true
ALKOL_DB_URL=jdbc:sqlserver://<server>:1433;databaseName=<AlkOL database>;integratedSecurity=true

# The file area, read only
ALKT_DOCUMENTS_DIR=<the directory Dokument of AlkT>
ALKT_ATTACHMENTS_DIR=<the directory Bilder of AlkT>
ALKOL_DOCUMENTS_DIR=<the directory of AlkOL>
ALKOL_ATTACHMENTS_DIR=<the directory of AlkOL>

# The local database: one file per environment, with an absolute path
AOT_LOADER_DB_URL=jdbc:h2:file:C:/migrering/aot-loader-test

# Settings that wait for decisions. Left blank, a dry run lists them and a real run does not start.
AOT_LOADER_ERRAND_STATUS=
AOT_LOADER_ROLE_INSPECTION_HOLDER=
